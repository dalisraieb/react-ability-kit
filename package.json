{
  "name": "react-ability-kit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "react",
    "permissions",
    "authorization",
    "rbac",
    "acl",
    "access-control",
    "typescript",
    "frontend-security",
    "react-permissions",
    "policy-based-access-control"
  ],
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dalisraieb/react-ability-kit"
  },
  "bugs": {
    "url": "https://github.com/dalisraieb/react-ability-kit/issues"
  },
  "homepage": "https://dalisraieb.github.io/react-ability-kit/"
}